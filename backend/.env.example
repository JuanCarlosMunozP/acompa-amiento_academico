# Django
SECRET_KEY=cambia-esta-clave-en-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL (esquema postgres://)
DATABASE_URL=postgres://tutorias_user:tutorias_pass@localhost:5432/tutorias_db
# CORS (orígenes del cliente; en local también se permiten direcciones privadas de Expo)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# En producción, agrega aquí el origen exacto del frontend desplegado.
# CORS_ALLOWED_ORIGINS=https://tutorias.ejemplo.edu.co
# Opcional: patrón regex para subdominios confiables.
# CORS_ALLOWED_ORIGIN_REGEXES=https://.*\.vercel\.app

# Verificación en dos pasos (MFA por QR/TOTP)
# MFA_EMISOR=Tutorías Académicas
# En producción define una clave propia (cualquier cadena larga y aleatoria) para cifrar los
# secretos TOTP; si se deja vacía se deriva de SECRET_KEY.
# MFA_CLAVE_CIFRADO=

# Registro y correo
# Dominios institucionales permitidos para registrarse (vacío = cualquiera, solo en local)
EMAIL_DOMINIOS_PERMITIDOS=
VERIFICACION_URL=http://localhost:8081/verificar-correo

# Mailpit local: Django corre en Windows y SMTP se publica en localhost:1025.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15
# Abre la bandeja en http://localhost:8025

# Docker futuro: si Django y Mailpit corren en la misma red de Compose, usa el nombre del servicio:
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025

# SMTP para producción (configura también el backend SMTP indicado arriba):
# EMAIL_HOST=smtp.ejemplo.edu.co
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Tutorías Académicas <no-responder@colegio.edu.co>

# Sesión (JWT) y control de intentos de login
# JWT_ACCESS_MINUTOS=15
# JWT_INACTIVIDAD_MINUTOS=30   # cierre de sesión por inactividad
# LOGIN_MAX_INTENTOS=5
# LOGIN_BLOQUEO_MINUTOS=15

# Recuperación de contraseña
RECUPERACION_URL=http://localhost:8081/nueva-contrasena
# RECUPERACION_MAX_SEGUNDOS=3600
# THROTTLE_RECUPERACION=5/hour

# Identidad en los correos
# INSTITUCION_NOMBRE=Colegio
# INSTITUCION_COLOR=#1F3A8A

# Ajustes avanzados (valores por defecto entre paréntesis)
# VERIFICACION_MAX_AGE=86400        # vigencia del enlace de verificación, en segundos (24 h)
# THROTTLE_REENVIO=5/hour           # límite de reenvíos del correo de verificación, por IP
# SECURE_SSL_REDIRECT=True          # solo producción: redirigir HTTP a HTTPS
# SECURE_HSTS_SECONDS=3600          # solo producción: HSTS

# Primer administrador (solo se usa al arrancar el contenedor; ver docs/despliegue.md)
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_NOMBRES=
# DJANGO_SUPERUSER_APELLIDOS=
