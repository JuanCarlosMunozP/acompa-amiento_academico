# URL base de la API (Django).
# En desarrollo, localhost se adapta automáticamente al host local de Expo en web y móvil.
# En builds de producción, configura aquí la URL HTTPS pública de la API.
EXPO_PUBLIC_API_URL=http://localhost:8001/api

# Minutos sin interacción antes de cerrar la sesión (igual que JWT_INACTIVIDAD_MINUTOS en la API)
EXPO_PUBLIC_INACTIVIDAD_MINUTOS=30
