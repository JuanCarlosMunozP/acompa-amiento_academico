# ============================================================
# SECRETOS Y DATOS SENSIBLES — nunca deben subirse al repositorio
# ============================================================

# Variables de entorno (se versiona solo la plantilla .env.example)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Credenciales de prueba / demostración
credenciales*
*credenciales*.txt
*credentials*
*secrets*
*.secret
*.secrets
secrets/
.secrets/

# Claves, certificados y almacenes de firma
*.pem
*.key
*.crt
*.cer
*.csr
*.der
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.p8
id_rsa*
id_ed25519*
frontend/certs/
certs/

# Configuración de servicios externos (Firebase, Google, etc.)
google-services.json
GoogleService-Info.plist
service-account*.json
firebase-adminsdk*.json
.npmrc
.pypirc
.netrc

# Copias de la base de datos y datos reales
backups/
*.sql
*.dump
*.bak
*.backup
*.sqlite
*.sqlite3
*.db
db.sqlite3
dumpdata*.json
fixtures_privados/

# Informes de pruebas que pueden contener datos de usuarios
reporte-pruebas-qa.txt
runtime-validation-report.md

# Registros
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

